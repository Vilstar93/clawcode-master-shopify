node_modules/
dist/
.env
.env.*
!.env.example
# Holds a 24-hour access token. Never commit it.
.shopify-token-cache.json
*.log
.DS_Store
clients/*/raw/
clients/*/private/
# A real client's logo, hero and product photos are the client's assets, and the
# config that references them is already gitignored. Only the example is tracked,
# so a real client's brand does not end up in the repository history.
clients/*/
!clients/README.md
!clients/example-firm/

# Real client configs hold a firm's ЕИК, email and phone. Only the example and
# the schema belong in the repository.
config/*.json
!config/client.example.json
!config/client.schema.json
