# Copy to .env and fill in. NEVER commit .env.

# --- Shopify Admin API (for product import) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Two credential shapes. Shopify stopped showing a copyable admin token on
# 1 January 2026, so a Dev Dashboard app holds a Client ID and secret instead.
#
# A) Client ID + secret (app and store in the same Shopify organization).
#    A token is requested automatically and cached for 24 hours.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# B) A stored token (authorization code grant). This is the only option for a
#    client's store, which is not in your organization.
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2026-01

# --- Shopify CLI (theme push) ---
# Prefer `shopify auth login` instead of storing a token here.
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxx

# --- AI providers (used by the agent, not by build scripts) ---
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional ---
OPENAI_BASE_URL=https://api.deepseek.com/v1
