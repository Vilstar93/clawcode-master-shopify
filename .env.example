# Copy to .env and fill in. NEVER commit .env.

# --- Shopify Admin API (for product import) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Two credential shapes, and they are not interchangeable.
#
# A) Client ID + secret (client credentials grant). Works only when the app and
#    the store are in the same Dev Dashboard organization, which means a dev
#    store. A token is requested automatically and cached for 24 hours.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# B) A stored token (authorization code grant). Required for a live store,
#    including your own and a client's: a live store is never in the app's
#    organization, so the grant above fails with application_cannot_be_found.
#    Get one with: node scripts/shopify-auth.mjs
SHOPIFY_ADMIN_TOKEN=

# Only needed by scripts/shopify-auth.mjs, and only if the app registered a
# redirect URL other than https://example.com/auth/callback.
SHOPIFY_REDIRECT_URI=https://example.com/auth/callback

# Which file the credential scripts read. Defaults to .env. Set it to keep one
# credentials file per client, or to point a test at a throwaway file.
SHOPIFY_ENV_FILE=

SHOPIFY_API_VERSION=2026-01

# --- Shopify CLI (theme push) ---
# Prefer `shopify auth login` instead of storing a token here.
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxx

# --- AI providers (used by the agent, not by build scripts) ---
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional ---
OPENAI_BASE_URL=https://api.deepseek.com/v1
